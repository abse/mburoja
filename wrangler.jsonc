{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mburoja",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "routes": [{ "pattern": "mburoja.selmani.info", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "./v2",
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": true,
    },
  },
}
